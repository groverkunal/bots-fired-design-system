---
import Docs from '../layouts/Docs.astro';
import { ComponentsSection } from '../app/components/ds/ComponentsSection';
const specs=[
['Button','Container, label, optional icon or progress label.','Primary, secondary, ghost and link; default, hover, focus, active, disabled and loading.','component.button.bg/fg/radius; duration.fast; semantic.color.focus.ring','Use a native button for actions and a link for navigation. aria-busy describes loading; native disabled blocks activation. A focusable aria-disabled control must explicitly suppress its handler.','44px minimum hit area; label remains visible at 390px.','Keep a clear action label.','Do not use Fire 500 behind normal-size white text.','<button type="button" class="reference-button">Continue</button>'],
['Card','Media, kicker, heading, description, metadata and one primary link.','Default, focus-within and hover; avoid overlapping nested actions.','component.card.radius/padding; semantic.color.bg.surface','Use a heading link and a logical heading level. Do not turn a noninteractive div into a button.','Single column, responsive media, readable text.','Keep links descriptive.','Do not put unrelated controls inside a stretched link.','<article class="docs-card"><h3><a href="/applications/">Application starters</a></h3><p>Choose a format.</p></article>'],
['Header','Brand link, navigation and preference controls.','Default and focus-visible; current page marked.','primitive.z.header; semantic.color.bg.surface','Use header and labelled nav landmarks. Keep focus visible and avoid hiding a focused header on scroll.','Wrap controls instead of shrinking the wordmark below its minimum.','Leave room for zoom and translated labels.','Do not hide focused controls on scroll.','<header><a href="/">BotsFired design system</a><nav aria-label="Main">…</nav></header>'],
['Navigation drawer','Trigger, native modal dialog, title, links and close button.','Closed, open, keyboard focus and Escape.','primitive.radius.xl; primitive.z.drawer','showModal gives native focus trapping and inert background. Escape closes it; restore focus to trigger. A close button is always available.','Width min(86vw,360px), no horizontal clipping.','Test keyboard focus and closing.','Do not rely only on swipe gestures.','<dialog aria-labelledby="drawer-title"><h2 id="drawer-title">Navigate</h2><button type="button">Close</button></dialog>'],
['Form field','Visible label, field, help text and associated error.','Empty, filled, focus, invalid, disabled and success.','component.input.radius; semantic.color.text.kicker','Associate label and input; use aria-describedby and aria-invalid. Set autocomplete and inputmode for the task.','48px field height, 16px text, error wraps.','Explain the correction in words.','Do not signal errors by colour alone.','<label for="email">Email</label><input id="email" type="email" autocomplete="email" aria-describedby="email-help"><p id="email-help">Use your email address.</p>'],
['Toast','Status text, optional dismiss control.','Hidden, announced and dismissed.','primitive.z.toast; duration.base','Use role=status for a polite result; alert only for urgent failures. This example persists until dismissed, avoiding timeout and focus problems.','Visible above safe area; max width calc(100vw - 32px).','Keep feedback concise and reviewable.','Do not announce every animation frame.','<div role="status">Example saved.</div>'],
['Article','Headline, byline, prose, figure, caption, sources and related action.','Reading, links focused and expanded footnotes.','fontFamily.body/mono; semantic.color.text.default','Use one H1, logical H2/H3 levels, figure/figcaption and descriptive sources.','68ch max measure, 16px minimum body, responsive figures.','Link sources for factual claims.','Do not use decorative Caveat as body copy.','<article><h2>Section</h2><p>Evidence-led text.</p><figure><img alt="Description" src="…"><figcaption>Source</figcaption></figure></article>'],
['Chip / filter','Button label and selected-state indicator.','Unselected, selected, focus and disabled.','primitive.radius.pill; semantic.color.focus.ring','Use aria-pressed for independent toggles; use radios for one-of-many choices.','44px hit area even with small visual chip.','Expose the selected state in text or semantics.','Do not use colour as the only state.','<button type="button" aria-pressed="false">Filter</button>'],
['Accordion','Summary control and content.','Collapsed, expanded and focus.','primitive.radius.md; semantic.color.border.default','Native details/summary supports keyboard disclosure without fake tab roles.','Summary has 44px hit area and wraps.','Use an informative summary.','Do not nest unrelated actions inside summary.','<details><summary>Details</summary><p>Expanded information.</p></details>'],
['Bottom sheet','Native modal dialog, title, content and close button.','Closed, open, focused and dismissed.','primitive.radius.xl; primitive.z.sheet','Native modal semantics; dragging is optional, never required. Restore focus after dismissal.','Maximum 85dvh with scrollable content.','Provide a visible close button.','Do not trap content beyond the viewport.','<dialog aria-labelledby="sheet-title"><h2 id="sheet-title">Details</h2><button type="button">Close</button></dialog>'],
['Embed card','Title, source, description and outbound link or media.','Unloaded, fallback link and loaded media.','component.card.radius/padding','Provide a source link and media title. Only load trusted embeds after privacy/security review; no new third-party embed is enabled here.','Responsive media and readable fallback.','Offer a link when media fails.','Do not autoplay sound.','<article><h3>Source title</h3><a href="https://botsfired.com">Open source</a></article>'],
['Stat card','Verified value, unit, period and source.','Available, unavailable and loading.','fontFamily.display; fontWeight.heavy','Expose units and dates in text. Values in samples are placeholders.','Value wraps or scales without hiding the unit.','Record evidence and reporting period.','Do not publish invented performance numbers.','<article><h3>Metric</h3><p>[Verified value]</p><p>Period and source</p></article>'],
['Callout','Heading or label, explanatory text and optional action.','Information, warning and error.','semantic.color.text.default; component.card.radius','Include words and optional decorative icon; use alert only when immediate interruption is necessary.','Text wraps; no fixed height.','Give a useful next step.','Do not depend solely on an icon or colour.','<aside aria-label="Review note"><p>Review before production.</p></aside>'],
];
---
<Docs title="Component specifications" active="components" description="Anatomy, states, tokens and accessible examples. These are reference implementations, not an audited production UI package."><section class="docs-card"><h2>Interactive examples</h2><div class="reference-demo"><h3>Buttons and feedback</h3><div class="docs-actions"><button class="reference-button" id="loading-example" type="button">Preview loading state</button><button disabled type="button">Unavailable</button><button id="toast-example" type="button">Show status</button></div><p id="button-result" role="status"></p><div id="toast-preview" hidden><p role="status">Example saved locally. No data was sent.</p><button id="toast-dismiss" type="button">Dismiss status</button></div></div><div class="reference-demo"><h3>Field validation</h3><form id="example-form" novalidate><label for="example-email">Email for this example</label><input id="example-email" type="email" inputmode="email" autocomplete="email" aria-describedby="example-email-help example-email-error"/><p id="example-email-help">Local demonstration only; nothing is submitted.</p><p id="example-email-error" class="field-error"></p><button class="reference-button" type="submit">Validate example</button></form></div><div class="reference-demo"><h3>Modal surfaces</h3><div class="docs-actions"><button data-open-dialog="drawer-example" type="button">Open navigation drawer</button><button data-open-dialog="sheet-example" type="button">Open bottom sheet</button></div><dialog id="drawer-example" aria-labelledby="drawer-title"><h2 id="drawer-title">Example navigation</h2><a href="/color/">Colour &amp; tokens</a><form method="dialog"><button>Close navigation</button></form></dialog><dialog id="sheet-example" aria-labelledby="sheet-title"><h2 id="sheet-title">Example bottom sheet</h2><p>Reviewable content with a visible close action; no dragging is required.</p><form method="dialog"><button>Close sheet</button></form></dialog></div><div class="reference-demo"><button id="filter-example" type="button" aria-pressed="false">Example filter: off</button><details><summary>Example accordion</summary><p>Native disclosure content is accessible without JavaScript.</p></details></div></section>{specs.map(([name,anatomy,states,tokens,a11y,mobile,yes,no,code])=><section class="docs-card"><h2>{name}</h2><dl><dt>Anatomy</dt><dd>{anatomy}</dd><dt>Variants &amp; states</dt><dd>{states}</dd><dt>Tokens</dt><dd><code>{tokens}</code></dd><dt>Accessibility</dt><dd>{a11y}</dd><dt>Mobile</dt><dd>{mobile}</dd><dt>Do</dt><dd>{yes}</dd><dt>Do not</dt><dd>{no}</dd></dl><pre><code>{code}</code></pre><button data-copy={code} aria-label={`Copy ${name} code`}>Copy code</button></section>)}<p class="copy-status" role="status"></p><details class="docs-card"><summary>Legacy interactive concept gallery</summary><p>Historical concept illustrations are not normative component implementations. All claims, dates and personas are placeholders.</p><div class="legacy-example"><ComponentsSection client:visible/></div></details></Docs>
<script>
const load=document.querySelector<HTMLButtonElement>('#loading-example')!;load.onclick=()=>{load.disabled=true;load.setAttribute('aria-busy','true');load.textContent='Loading preview…';setTimeout(()=>{load.disabled=false;load.removeAttribute('aria-busy');load.textContent='Preview loading state';document.querySelector('#button-result')!.textContent='Loading preview complete.'},800)};
const toast=document.querySelector<HTMLElement>('#toast-preview')!;document.querySelector<HTMLButtonElement>('#toast-example')!.onclick=()=>toast.hidden=false;document.querySelector<HTMLButtonElement>('#toast-dismiss')!.onclick=()=>{toast.hidden=true;document.querySelector<HTMLButtonElement>('#toast-example')!.focus()};
const form=document.querySelector<HTMLFormElement>('#example-form')!;const email=document.querySelector<HTMLInputElement>('#example-email')!;form.onsubmit=e=>{e.preventDefault();const valid=email.value.trim()!==''&&email.validity.valid;email.setAttribute('aria-invalid',String(!valid));document.querySelector('#example-email-error')!.textContent=valid?'Example valid. No data was sent.':'Error: enter a valid email address for this example.';if(!valid)email.focus()};
document.querySelectorAll<HTMLButtonElement>('[data-open-dialog]').forEach(button=>{const dialog=document.getElementById(button.dataset.openDialog!)as HTMLDialogElement;button.onclick=()=>dialog.showModal();dialog.onclose=()=>button.focus();dialog.onclick=e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()}}});
const filter=document.querySelector<HTMLButtonElement>('#filter-example')!;filter.onclick=()=>{const selected=filter.getAttribute('aria-pressed')!=='true';filter.setAttribute('aria-pressed',String(selected));filter.textContent=`Example filter: ${selected?'on':'off'}`};
</script>
<style>dt{font-weight:700;margin-top:1rem}dd{line-height:1.65}summary{min-height:44px;cursor:pointer;padding:12px 0}#example-email{width:100%;min-height:48px}#sheet-example{position:fixed;inset:auto 0 0;margin:0 auto;width:min(100%,800px);max-width:100%;border-radius:24px 24px 0 0}#toast-preview{margin-top:1rem;padding:1rem;border:1px solid currentColor;max-width:calc(100vw - 32px)}</style>
