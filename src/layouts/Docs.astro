---
import '../styles/index.css';
import '../styles/docs.css';
import { BFLogoSVG } from '../app/components/ds/BFLogoSVG';
const {title='Clarity, by design.',description='BotsFired foundations, components and brand assets.',active='overview'}=Astro.props;
const chapters=[['overview','Overview','/'],['logos','Logo System','/logos/'],['typography','Typography','/typography/'],['color','Colour & tokens','/color/'],['components','Component specifications','/components/'],['templates','Templates','/templates/'],['platforms','Platforms','/platforms/'],['applications','Applications','/applications/'],['assets','Asset library','/assets-library/'],['governance','Governance','/governance/'],['motion','Motion & iconography','/motion/'],['verify','Spec tests','/verify/']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content={description}/><meta name="theme-color" content="#0D1829"/><title>{title} · BotsFired design system</title></head><body><div class="ds-hub docs-shell" data-theme="light" data-high-contrast="false"><a class="ds-skip" href="#ds-content">Skip to content</a><header class="docs-header"><a href="/" aria-label="BotsFired design system home"><BFLogoSVG variant="wordmark" theme="color" width={200}/></a><div class="docs-tools"><button id="theme-toggle" type="button" aria-pressed="false">Dark mode: off</button><button id="contrast-toggle" type="button" aria-pressed="false">High contrast: off</button><a href="https://botsfired.com">Visit BotsFired</a></div></header><div class="docs-grid"><aside class="docs-sidebar"><p class="docs-kicker">Explore the system</p><label for="docs-search">Find a chapter</label><input id="docs-search" type="search" placeholder="Search navigation" autocomplete="off"/><nav aria-label="Design system sections">{chapters.map(([id,label,url])=><a href={url} aria-current={id===active?'page':undefined}>{label}</a>)}</nav><p id="search-status" role="status"></p><p class="docs-meta">Local preview release 0.1.0<br/>Unlisted public reference</p></aside><main id="ds-content" tabindex="-1"><div class="docs-intro"><p class="docs-kicker">The BotsFired brand library</p><h1>{title}</h1><p>{description}</p></div><slot/><section class="docs-downloads" aria-labelledby="downloads-title"><h2 id="downloads-title">Take the system with you</h2><div class="docs-actions"><a class="ds-download" href="/assets/botsfired-tokens.json" download>DTCG tokens · JSON</a><a class="ds-download" href="/assets/botsfired-tokens.css" download>Generated CSS</a><a class="ds-download" href="/assets/botsfired-tokens-resolved.json" download>Resolved values · JSON</a><a class="ds-download" href="/assets-library/">All asset formats</a></div></section></main></div><footer class="docs-footer">© 2026 BotsFired · No jargon. Just signal. · New application starters require production review.</footer></div><script>
const root=document.querySelector<HTMLElement>('.docs-shell')!;
const theme=document.querySelector<HTMLButtonElement>('#theme-toggle')!;
const contrast=document.querySelector<HTMLButtonElement>('#contrast-toggle')!;
function preference(key:string,fallback:string){try{return localStorage.getItem(key)||fallback}catch{return fallback}}
function apply(){const dark=root.dataset.theme==='dark';theme.textContent=`Dark mode: ${dark?'on':'off'}`;theme.setAttribute('aria-pressed',String(dark));const high=root.dataset.highContrast==='true';contrast.textContent=`High contrast: ${high?'on':'off'}`;contrast.setAttribute('aria-pressed',String(high));document.querySelector('meta[name="theme-color"]')?.setAttribute('content',high?'#FFFFFF':dark?'#09101C':'#FAFAF8')}
root.dataset.theme=preference('botsfired-theme',matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');root.dataset.highContrast=preference('botsfired-high-contrast','false');apply();
theme.onclick=()=>{root.dataset.theme=root.dataset.theme==='dark'?'light':'dark';try{localStorage.setItem('botsfired-theme',root.dataset.theme)}catch{}apply()};contrast.onclick=()=>{root.dataset.highContrast=String(root.dataset.highContrast!=='true');try{localStorage.setItem('botsfired-high-contrast',root.dataset.highContrast)}catch{}apply()};
const search=document.querySelector<HTMLInputElement>('#docs-search')!;search.oninput=()=>{let count=0;document.querySelectorAll<HTMLAnchorElement>('.docs-sidebar nav a').forEach(a=>{a.hidden=!a.textContent?.toLowerCase().includes(search.value.toLowerCase());if(!a.hidden)count++});document.querySelector('#search-status')!.textContent=search.value?`${count} chapters match`:''};
document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button=>{button.onclick=async()=>{let message='Copied.';try{await navigator.clipboard.writeText(button.dataset.copy!)}catch{message='Clipboard unavailable. Select and copy the visible value manually.'}document.querySelectorAll('.copy-status').forEach(el=>el.textContent=message)}});
const routes:Record<string,string>={logos:'/logos/',typography:'/typography/',color:'/color/',components:'/components/',templates:'/templates/',platforms:'/platforms/',applications:'/applications/',assets:'/assets-library/',governance:'/governance/',verify:'/verify/'};if((location.pathname==='/'||location.pathname==='/design-system/')&&routes[location.hash.slice(1)])location.replace(routes[location.hash.slice(1)]);
</script></body></html>
