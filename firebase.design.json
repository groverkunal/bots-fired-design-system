{
  "hosting": {
    "site": "botsfired-design",
    "public": "dist",
    "ignore": ["**/.*", "**/node_modules/**"],
    "rewrites": [{"source": "**", "destination": "/index.html"}],
    "headers": [{"source": "**", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}, {"key": "X-Content-Type-Options", "value": "nosniff"}]}]
  }
}
